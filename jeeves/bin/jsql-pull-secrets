#!/usr/bin/env bash
# Pull MySQL credentials from AWS Secrets Manager for all dev/qa/preprod environments.
# Usage: jsql-pull-secrets [env-name]   — pull one env
#        jsql-pull-secrets              — pull all envs
#
# Writes one .env file per env into the directory `jsql` reads from.
#
# Requires an authenticated AWS SSO session for the profile below:
#   aws sso login --profile jeeves_dev
#
# Shared overrides (JEEVES_SECRETS_DIR, JEEVES_DB_HOST, JEEVES_DB_PORT) are
# defined in lib/jsql-common.sh. Specific to this command:
#   JEEVES_DB_HOST        endpoint hostname; skips the RDS lookup when set
#   JEEVES_DB_INSTANCE_ID RDS instance to resolve the endpoint from
#   JEEVES_DB_PORT        port written into each file (default: 3306)
#   AWS_PROFILE           AWS profile (default: jeeves_dev)

set -euo pipefail

_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_LIB="$_BIN_DIR/../lib/jsql-common.sh"
if [[ ! -f "$_LIB" ]]; then
  echo "Shared library not found: $_LIB" >&2
  echo "jsql-pull-secrets runs from the plugin's bin/, with lib/ as its sibling." >&2
  exit 1
fi
source "$_LIB"

MYSQL_DIR="$JEEVES_SECRETS_DIR"
PROFILE="${AWS_PROFILE:-jeeves_dev}"
REGION="us-east-2"
MYSQL_PORT="${JEEVES_DB_PORT:-3306}"

# Resolve the DB endpoint from the instance id rather than hardcoding it, so the
# account-specific endpoint hostname stays out of this file.
DB_INSTANCE_ID="${JEEVES_DB_INSTANCE_ID:-development-db-useast2}"

if [[ -n "${JEEVES_DB_HOST:-}" ]]; then
  MYSQL_HOST="$JEEVES_DB_HOST"
else
  echo -n "Resolving endpoint for $DB_INSTANCE_ID ... "
  MYSQL_HOST=$(aws --profile "$PROFILE" --region "$REGION" \
    rds describe-db-instances \
    --db-instance-identifier "$DB_INSTANCE_ID" \
    --query "DBInstances[0].Endpoint.Address" --output text 2>/dev/null) || MYSQL_HOST=""

  if [[ -z "$MYSQL_HOST" || "$MYSQL_HOST" == "None" ]]; then
    echo "FAILED"
    echo "Could not resolve the endpoint for RDS instance '$DB_INSTANCE_ID'." >&2
    echo "Set JEEVES_DB_HOST to the endpoint hostname, or confirm profile '$PROFILE'" >&2
    echo "is authenticated (aws sso login --profile $PROFILE) and allows rds:DescribeDBInstances." >&2
    exit 1
  fi
  echo "OK"
fi

# Credentials are owner-only: create the directory 0700 and each file 0600,
# regardless of the caller's umask.
umask 077
mkdir -p "$MYSQL_DIR"
chmod 700 "$MYSQL_DIR"

# Note: prod is intentionally absent — its secret is not in the Secrets Manager
# account we have access to, so prod.env is managed manually.
ENVS=(
  develop-01 develop-02 develop-03 develop-04 develop-05
  develop-06 develop-07 develop-08 develop-09 develop-10
  develop-11 develop-12 develop-13 develop-14 develop-15
  develop-16 develop-17 develop-18 develop-19 develop-20
  development qa sandbox preprod
)

pull_env() {
  local ENV="$1"
  local SECRET_ID="/$ENV/api-backend/api-be-secrets"
  local OUT="$MYSQL_DIR/$ENV.env"

  echo -n "  Pulling $ENV ... "

  local SECRET
  SECRET=$(aws --profile "$PROFILE" --region "$REGION" \
    secretsmanager get-secret-value \
    --secret-id "$SECRET_ID" \
    --query SecretString --output text 2>&1) || {
    echo "SKIP (secret not found)"
    return
  }

  local DB USER PASS
  DB=$(echo "$SECRET"   | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('MYSQL_DATABASE',''))")
  USER=$(echo "$SECRET" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('MYSQL_USER',''))")
  PASS=$(echo "$SECRET" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('MYSQL_PASSWORD',''))")

  cat > "$OUT" <<EOF
MYSQL_HOST=$MYSQL_HOST
MYSQL_PORT=$MYSQL_PORT
MYSQL_USER=$USER
MYSQL_PASS=$PASS
MYSQL_DB=$DB
MYSQL_SSL=true
EOF

  echo "OK -> $ENV.env"
}

if [[ $# -eq 1 ]]; then
  pull_env "$1"
else
  echo "Pulling secrets for ${#ENVS[@]} environments..."
  for ENV in "${ENVS[@]}"; do
    pull_env "$ENV"
  done
  echo "Done. Files written to $MYSQL_DIR/"
fi
